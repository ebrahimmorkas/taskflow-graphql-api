NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskflow
# Apply pending migrations automatically on startup
DB_MIGRATIONS_RUN=true

# Auth
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
JWT_TTL=1d

# Redis (optional) — PubSub backend for GraphQL subscriptions.
# Disabled: in-memory PubSub (single instance). Enabled: subscriptions work across instances.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Reject queries whose estimated cost exceeds this value
GRAPHQL_MAX_COMPLEXITY=300
